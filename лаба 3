from abc import ABC, abstractmethod  # ABC і abstractmethod потрібні для абстрактного класу

# ---------------------------------------------------------------------------
# Лямбда-функції
# ---------------------------------------------------------------------------
format_price = lambda value: f"{value:.2f}грн"  # ціна у форматі ххх.ххгрн
line_total = lambda product, qty: product.price * qty  # сума за один рядок: ціна * кількість
cart_total = lambda items: sum(map(lambda pair: line_total(*pair), items))  # сума всього кошика

ADMIN_PASSWORD = "admin123"  # пароль адміністратора


# ---------------------------------------------------------------------------
# Допоміжна функція
# ---------------------------------------------------------------------------
def ask_int(prompt):  # питає у користувача ціле число
    while True:  # повторюємо, поки не введуть правильно
        text = input(prompt).strip()  # читаємо рядок і прибираємо пробіли
        if text.lstrip("-").isdigit():  # перевіряємо, що це число (можливо з мінусом)
            return int(text)  # перетворюємо в int і повертаємо
        print("Введіть, будь ласка, ціле число.")  # повідомлення про помилку вводу


# ---------------------------------------------------------------------------
# Модель даних
# ---------------------------------------------------------------------------
class Product:  # клас "Товар"
    def __init__(self, product_id, name, price, stock):  # конструктор товару
        self._id = product_id  # приватне поле: номер товару
        self._name = name  # приватне поле: назва
        self._price = price  # приватне поле: ціна
        self._stock = stock  # приватне поле: залишок на складі

    @property  # робимо метод доступним як поле (тільки читання)
    def id(self):  # геттер номера
        return self._id  # повертаємо номер

    @property  # властивість тільки для читання
    def name(self):  # геттер назви
        return self._name  # повертаємо назву

    @property  # властивість тільки для читання
    def price(self):  # геттер ціни
        return self._price  # повертаємо ціну

    @property  # властивість тільки для читання
    def stock(self):  # геттер залишку
        return self._stock  # повертаємо залишок

    def reduce_stock(self, qty):  # зменшує залишок після покупки
        if qty > self._stock:  # якщо просять більше, ніж є
            raise ValueError(f"Недостатньо товару '{self._name}' на складі.")  # кидаємо помилку
        self._stock -= qty  # віднімаємо куплену кількість

    def __str__(self):  # як товар виводиться через print
        return f"{self._id}. {self._name} - {format_price(self._price)} (залишок: {self._stock})"  # рядок товару


class Catalog:  # клас "Каталог": зберігає і шукає товари
    def __init__(self, products):  # отримує список товарів ззовні (DI)
        self._products = {p.id: p for p in products}  # словник: номер -> товар

    def get(self, product_id):  # пошук товару за номером
        return self._products.get(product_id)  # товар або None, якщо не знайдено

    def all(self):  # усі товари
        return sorted(self._products.values(), key=lambda p: p.id)  # сортуємо за номером (лямбда)

    def in_stock(self):  # тільки товари, що є в наявності
        return list(filter(lambda p: p.stock > 0, self.all()))  # фільтруємо за залишком (лямбда)


class Cart:  # клас "Кошик"
    def __init__(self):  # конструктор кошика
        self._items = {}  # приватний словник: товар -> кількість

    def add(self, product, qty=1):  # додає товар у кошик
        if qty <= 0:  # кількість має бути додатною
            raise ValueError("Кількість має бути більшою за 0.")  # помилка
        new_qty = self._items.get(product, 0) + qty  # скільки буде в кошику після додавання
        if new_qty > product.stock:  # не можна взяти більше, ніж є на складі
            raise ValueError(f"На складі лише {product.stock} шт. товару '{product.name}'.")  # помилка
        self._items[product] = new_qty  # зберігаємо нову кількість

    def remove(self, product, qty=None):  # видаляє товар повністю або частково
        if product not in self._items:  # якщо товару немає в кошику
            raise ValueError("Цього товару немає в кошику.")  # помилка
        if qty is None or qty >= self._items[product]:  # видаляємо все
            del self._items[product]  # прибираємо товар з кошика
        elif qty > 0:  # видаляємо тільки частину
            self._items[product] -= qty  # зменшуємо кількість
        else:  # некоректна кількість
            raise ValueError("Кількість має бути більшою за 0.")  # помилка

    def items(self):  # список (товар, кількість)
        return list(self._items.items())  # копія вмісту кошика

    def total(self):  # загальна сума
        return cart_total(self.items())  # рахуємо лямбдою

    def is_empty(self):  # чи порожній кошик
        return not self._items  # True, якщо нічого немає

    def clear(self):  # очищення кошика
        self._items.clear()  # видаляємо все


class OrderService:  # клас "Оформлення замовлення" (окрема відповідальність)
    def checkout(self, cart):  # купує товари з кошика
        if cart.is_empty():  # якщо купувати нічого
            raise ValueError("Кошик порожній.")  # помилка
        for product, qty in cart.items():  # спочатку перевіряємо всі товари
            if qty > product.stock:  # якщо не вистачає на складі
                raise ValueError(f"Недостатньо товару '{product.name}' на складі.")  # помилка
        receipt = list(cart.items())  # запам'ятовуємо товари для чека
        total = cart.total()  # запам'ятовуємо суму
        for product, qty in receipt:  # проходимо по товарах чека
            product.reduce_stock(qty)  # списуємо зі складу
        cart.clear()  # очищаємо кошик після покупки
        return receipt, total  # повертаємо дані для чека


# ---------------------------------------------------------------------------
# Користувачі (абстракція + наслідування + поліморфізм)
# ---------------------------------------------------------------------------
class User(ABC):  # абстрактний клас користувача
    def __init__(self, name):  # конструктор
        self._name = name  # приватне поле: назва ролі

    @abstractmethod  # метод без реалізації: нащадки зобов'язані його написати
    def actions(self):  # повертає список пунктів меню
        pass  # тіло порожнє, бо метод абстрактний

    def run(self):  # спільний цикл меню для всіх ролей
        while True:  # крутимо меню, поки не вийдуть
            actions = self.actions()  # отримуємо пункти меню (поліморфізм)
            print(f"\n=== Меню ({self._name}) ===")  # заголовок меню
            for number, (label, _) in enumerate(actions, 1):  # нумеруємо пункти з 1
                print(f"{number}. {label}")  # виводимо пункт
            print("0. Вийти")  # пункт виходу

            choice = ask_int("Ваш вибір: ")  # читаємо вибір користувача
            if choice == 0:  # вихід з меню
                break  # перериваємо цикл
            if 1 <= choice <= len(actions):  # якщо номер існує
                try:  # ловимо помилки дій
                    actions[choice - 1][1]()  # викликаємо функцію вибраного пункту
                except ValueError as error:  # якщо дія кинула помилку
                    print(f"Помилка: {error}")  # показуємо текст помилки
            else:  # номер неіснуючий
                print("Такого пункту немає.")  # повідомлення


class Customer(User):  # покупець (наслідує User)
    def __init__(self, catalog, cart, order_service):  # залежності передаються ззовні (DI)
        super().__init__("Покупець")  # викликаємо конструктор батька
        self._catalog = catalog  # зберігаємо каталог
        self._cart = cart  # зберігаємо кошик
        self._order_service = order_service  # зберігаємо сервіс замовлень

    def actions(self):  # меню покупця
        return [  # список: (назва пункту, функція)
            ("Переглянути каталог", self.show_catalog),  # пункт 1
            ("Додати товар в кошик", self.add_to_cart),  # пункт 2
            ("Переглянути кошик", self.show_cart),  # пункт 3
            ("Видалити товар з кошика", self.remove_from_cart),  # пункт 4
            ("Купити товари з кошика", self.buy),  # пункт 5
        ]

    def _find_product(self):  # допоміжний метод: питає номер і шукає товар
        product = self._catalog.get(ask_int("Введіть номер товару: "))  # шукаємо в каталозі
        if product is None:  # якщо не знайшли
            raise ValueError("Товару з таким номером не існує.")  # помилка
        return product  # повертаємо знайдений товар

    def show_catalog(self):  # показує каталог
        print("\n--- Каталог ---")  # заголовок
        for product in self._catalog.in_stock():  # проходимо по товарах в наявності
            print(f"{product.id}. {product.name} - {format_price(product.price)}")  # виводимо товар

    def add_to_cart(self):  # додає товар у кошик
        self.show_catalog()  # спочатку показуємо каталог
        product = self._find_product()  # вибираємо товар
        qty = ask_int("Кількість: ")  # питаємо кількість
        self._cart.add(product, qty)  # додаємо в кошик
        print(f"Додано: {product.name} x {qty}")  # підтвердження

    def show_cart(self):  # показує кошик
        if self._cart.is_empty():  # якщо порожній
            print("\nКошик порожній.")  # повідомляємо
            return  # виходимо з методу
        print("\n--- Кошик ---")  # заголовок
        for product, qty in self._cart.items():  # проходимо по товарах кошика
            print(f"{product.id}. {product.name} x {qty} = {format_price(line_total(product, qty))}")  # рядок кошика
        print(f"Разом: {format_price(self._cart.total())}")  # загальна сума

    def remove_from_cart(self):  # видаляє товар з кошика
        self.show_cart()  # показуємо кошик
        if self._cart.is_empty():  # якщо видаляти нічого
            return  # виходимо
        product = self._find_product()  # вибираємо товар
        qty = ask_int("Скільки видалити (0 - видалити все): ")  # питаємо кількість
        self._cart.remove(product, qty if qty > 0 else None)  # 0 означає видалити все
        print("Товар видалено з кошика.")  # підтвердження

    def buy(self):  # купує товари з кошика
        receipt, total = self._order_service.checkout(self._cart)  # оформлюємо замовлення
        print("\n--- Чек ---")  # заголовок чека
        for product, qty in receipt:  # проходимо по купленому
            print(f"{product.name} x {qty} = {format_price(line_total(product, qty))}")  # рядок чека
        print(f"До сплати: {format_price(total)}")  # підсумок
        print("Дякуємо за покупку!")  # подяка


class Admin(User):  # адміністратор (наслідує User)
    def __init__(self, catalog):  # отримує каталог ззовні (DI)
        super().__init__("Адміністратор")  # викликаємо конструктор батька
        self._catalog = catalog  # зберігаємо каталог

    def actions(self):  # меню адміністратора (інше, ніж у покупця: поліморфізм)
        return [("Переглянути залишки", self.show_stock)]  # єдиний пункт

    def show_stock(self):  # показує залишки на складі
        print("\n--- Залишки на складі ---")  # заголовок
        for product in self._catalog.all():  # проходимо по всіх товарах
            print(product)  # виводимо товар разом із залишком


# ---------------------------------------------------------------------------
# Запуск програми
# ---------------------------------------------------------------------------
def create_catalog():  # створює початковий каталог
    return Catalog([  # список товарів магазину
        Product(1, "Хліб", 25.50, 20),  # номер, назва, ціна, залишок
        Product(2, "Молоко", 42.00, 15),  # товар 2
        Product(3, "Сир", 180.99, 8),  # товар 3
        Product(4, "Яблука (1 кг)", 35.75, 30),  # товар 4
        Product(5, "Кава", 250.00, 5),  # товар 5
    ])


def admin_login():  # перевірка пароля адміна
    for _ in range(3):  # 3 спроби
        if input("Пароль адміністратора: ") == ADMIN_PASSWORD:  # порівнюємо з паролем
            return True  # пароль вірний
        print("Невірний пароль.")  # повідомлення про помилку
    return False  # спроби закінчилися


def main():  # головна функція програми
    catalog = create_catalog()  # створюємо каталог
    cart = Cart()  # створюємо кошик
    order_service = OrderService()  # створюємо сервіс замовлень

    while True:  # головне меню
        print("\n=== МІНІ-МАГАЗИН ===")  # заголовок
        print("1. Увійти як покупець")  # пункт 1
        print("2. Увійти як адміністратор")  # пункт 2
        print("0. Вихід")  # пункт виходу
        choice = ask_int("Ваш вибір: ")  # читаємо вибір

        if choice == 1:  # покупець
            Customer(catalog, cart, order_service).run()  # запускаємо меню покупця
        elif choice == 2:  # адміністратор
            if admin_login():  # якщо пароль вірний
                Admin(catalog).run()  # запускаємо меню адміна
        elif choice == 0:  # вихід
            print("До побачення!")  # прощання
            break  # завершуємо цикл
        else:  # неіснуючий пункт
            print("Такого пункту немає.")  # повідомлення


if __name__ == "__main__":  # запуск тільки якщо файл відкрито напряму
    main()  # стартуємо програму
